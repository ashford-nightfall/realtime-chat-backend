{
  "ignorePatterns": ["dist/**", "*.yml", "*.yaml", "*.md"],
  "printWidth": 95,
  "sortImports": {
    "order": "asc",
    "ignoreCase": true,
    "newlinesBetween": true,

    "groups": [
      ["builtin", "external"],
      ["internal", "subpath"],
      ["parent", "sibling", "index"]
    ]
  }
}
